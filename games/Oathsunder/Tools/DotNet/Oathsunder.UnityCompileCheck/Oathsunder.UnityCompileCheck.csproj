<Project Sdk="Microsoft.NET.Sdk">
  <!--
    C#-level type check of the Unity-facing assemblies (Gameplay, Editor, PlayMode tests) against a minimal stub
    of the UnityEngine/UnityEditor API surface they use. It catches language errors (types, refs, usings, typos)
    outside the editor. It does NOT prove the Unity API signatures: the Unity compile in CI is authoritative.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <OutputType>Library</OutputType>
    <DefineConstants>$(DefineConstants);UNITY_EDITOR;UNITY_INCLUDE_TESTS</DefineConstants>
    <NoWarn>$(NoWarn);CS1591;CS0067;CS0649;CS0169;CS0414</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="UnityStubs.cs" />
    <Compile Include="$(UnityAssetsRoot)Runtime/Gameplay/**/*.cs" />
    <Compile Include="$(UnityAssetsRoot)Editor/**/*.cs" />
    <Compile Include="$(UnityAssetsRoot)Tests/PlayMode/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="NUnit" Version="3.14.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Oathsunder.Simulation/Oathsunder.Simulation.csproj" />
  </ItemGroup>
</Project>
